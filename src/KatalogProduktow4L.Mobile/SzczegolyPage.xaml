<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KatalogProduktow4L.Mobile.SzczegolyPage"
             Title="Szczegóły produktu">

    <VerticalStackLayout Padding="30" Spacing="15">
        <Label Text="Nazwa:" FontAttributes="Bold" />
        <Entry x:Name="nazwaEntry" Text="{Binding Nazwa}" />

        <Label Text="Kategoria:" FontAttributes="Bold" />
        <Entry x:Name="kategoriaEntry" Text="{Binding Kategoria}" />

        <Label Text="Cena:" FontAttributes="Bold" />
        <Entry x:Name="cenaEntry" Text="{Binding Cena}" Keyboard="Numeric" />

        <Label Text="{Binding Ilosc, StringFormat='W magazynie: {0} szt.'}" />
        <Label Text="{Binding WartoscMagazynu, StringFormat='Wartość magazynu: {0:C}'}" />
        <Label x:Name="opisLabel" />

        <Button Text="Zapisz zmiany" Clicked="Zapisz_Clicked" />
        <Button Text="Wróć do listy" Clicked="Wroc_Clicked" />
        <Button Text="Usunąć produkt" Clicked="UsunProdukt_Clicked" />
    </VerticalStackLayout>

</ContentPage>
