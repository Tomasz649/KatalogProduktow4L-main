<Window x:Class="KatalogProduktow4L.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogProduktow4L.Desktop"
        mc:Ignorable="d"
        Title="Katalog Produktów"
        Height="836" Width="1176">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Nagłówek -->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="Katalog produktów"
                   HorizontalAlignment="Center"
                   FontSize="24"
                   Margin="0,0,0,20"/>

        <!-- Lista produktów -->
        <ListBox x:Name="ProductsListBox"
                 Grid.Row="1"
                 Grid.Column="0"
                 SelectionChanged="ProductsListBox_SelectionChanged">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="{Binding Nazwa}"
                                   Width="220"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding Kategoria}"
                                   Width="120"/>

                        <TextBlock Text="{Binding Cena,
                                   StringFormat={}{0:F2} zł}"
                                   Width="100"/>

                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <!-- Szczegóły produktu -->
        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="20,0,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>

            <!-- SZCZEGÓŁY PRODUKTU -->
            <GroupBox Header="Szczegóły produktu"
                      Grid.Row="0"
                      Margin="0,0,0,10"
                      Padding="10">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock x:Name="DetailsTextBlock"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Nazwa:"
                                   FontWeight="Bold"/>

                        <TextBox x:Name="NameTextBox"
                                 IsReadOnly="True"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Kategoria:"
                                   FontWeight="Bold"/>

                        <ComboBox x:Name="CategoryComboBox"
                                  IsEnabled="False"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Ilość:"
                                   FontWeight="Bold"/>

                        <TextBox x:Name="QuantityTextBox"
                                 IsReadOnly="True"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Cena:"
                                   FontWeight="Bold"/>

                        <TextBox x:Name="PriceTextBox"
                                 IsReadOnly="True"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Wartość magazynu:"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>

                        <StackPanel Orientation="Vertical"
                                    Margin="0,0,0,10">
                        </StackPanel>

                        <StackPanel x:Name="AdditionalStackPanel"
                                    Margin="0,10,0,0"/>

                    </StackPanel>

                </ScrollViewer>

            </GroupBox>

            <!-- DODAWANIE PRODUKTU -->
            <GroupBox Header="Dodaj produkt"
                      Grid.Row="1"
                      Padding="10">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <Grid Margin="0,5">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Nazwa:"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>

                        <TextBox x:Name="NewNameTextBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="0,5"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Cena:"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>

                        <TextBox x:Name="NewPriceTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,5"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Kategoria:"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>

                        <ComboBox x:Name="NewCategoryComboBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="0,5"/>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Ilość:"
                                   VerticalAlignment="Center"
                                   Margin="0,5"/>

                        <TextBox x:Name="NewQuantityTextBox"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Margin="0,5"/>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="Rodzaj:"
                                   VerticalAlignment="Top"
                                   Margin="0,5"/>

                        <StackPanel Grid.Row="4"
                                    Grid.Column="1"
                                    Orientation="Vertical"
                                    Margin="0,5">

                            <RadioButton x:Name="ProduktRadioButton"
                                        Content="Produkt"
                                        GroupName="Rodzaj"
                                        IsChecked="True"
                                        Margin="0,3"/>

                            <RadioButton x:Name="PodzespolRadioButton"
                                        Content="Podzespół"
                                        GroupName="Rodzaj"
                                        Margin="0,3"/>

                            <RadioButton x:Name="AkcesoriumRadioButton"
                                        Content="Akcesorium"
                                        GroupName="Rodzaj"
                                        Margin="0,3"/>

                            <RadioButton x:Name="UslugaRadioButton"
                                        Content="Usługa"
                                        GroupName="Rodzaj"
                                        Margin="0,3"/>

                        </StackPanel>

                        <Button Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Content="Dodaj produkt"
                                Height="30"
                                Margin="0,10,0,5"
                                Click="AddProductButton_Click"/>

                    </Grid>

                </ScrollViewer>

            </GroupBox>

        </Grid>

    </Grid>

</Window>
