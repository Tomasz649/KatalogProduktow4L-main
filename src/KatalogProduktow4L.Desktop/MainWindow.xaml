<Window x:Class="KatalogProduktow4L.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogProduktow4L.Desktop"
        mc:Ignorable="d"
        Title="KatalogProduktow4L.Desktop" Height="450" Width="800">

    <StackPanel>
        <TextBlock Text="Katalog Produktów"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   FontSize="24"/>

        <ListBox x:Name="ProductsListBox"
                 DisplayMemberPath="Nazwa"
                 SelectionChanged="ProductsListBox_SelectionChanged" Height="100"/>

        <TextBlock x:Name="DetailsTextBlock"
                   Margin="10"
                   TextWrapping="Wrap"/>
    </StackPanel>
</Window>
